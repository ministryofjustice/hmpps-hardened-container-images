{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>ministryofjustice/hmpps-renovate-config:node",
    "helpers:pinGitHubActionDigests"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^images/node/alpine-runtime/apko\\.yaml$"],
      "matchStrings": ["ca-certificates(?:-bundle)?=(?<currentValue>[^\\s]+)"],
      "datasourceTemplate": "repology",
      "depNameTemplate": "alpine_3_24/ca-certificates",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "fileMatch": ["^images/node/alpine-runtime/apko\\.yaml$"],
      "matchStrings": ["libstd\\+\\+=(?<currentValue>[^\\s]+)"],
      "datasourceTemplate": "repology",
      "depNameTemplate": "alpine_3_24/libstd++",
      "versioningTemplate": "loose"
    }
  ],
  "prBodyTemplate": "{{{table}}}{{{notes}}}{{{warnings}}}{{{controls}}}",
  "dependencyDashboard": true,
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["npm"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "rangeStrategy": "bump",
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchDepTypes": ["engines"],
      "enabled": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchPackageNames": ["typescript", "govuk-frontend"],
      "rangeStrategy": "bump",
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node", "hmpps-node"],
      "matchUpdateTypes": ["major"],
      "enabled": true,
      "pinDigests": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["workflow"],
      "matchFileNames": ["**/.github/workflows/**/*.ya?ml"],
      "enabled": true,
      "pinDigests": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/ministryofjustice/hmpps-node"],
      "replacementName": "ghcr.io/ministryofjustice/hmpps-hardened-container-images/node-alpine",
      "replacementVersion": "24-npm11-docker-main",
      "pinDigests": true
    },
    {
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest", "bump"],
      "groupName": "routine dependencies",
      "groupSlug": "routine-dependencies",
      "pinDigests": true,
      "minimumReleaseAge": "7 days",
      "automerge": true,
      "automergeComment": "Automatically merging routine dependency updates"
    },
    {
      "matchUpdateTypes": ["major"],
      "pinDigests": true,
      "groupName": null
    }

  ],
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "7 days",
    "enabled": true,
    "labels": ["security-fix"]
  },
  "osvVulnerabilityAlerts": true,
  "platformCommit": "enabled"
}
