{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>ministryofjustice/hmpps-renovate-config:node",
    "helpers:pinGitHubActionDigests"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images\\/.*\\/(?:apko|melange[^/]*)\\.ya?ml$/"],
      "matchStrings": ["(?:^|\\n)[ \\t]*-[ \\t]+ca-certificates(?:-bundle)?=(?<currentValue>[^\\s]+)"],
      "datasourceTemplate": "repology",
      "depNameTemplate": "alpine_3_24/ca-certificates",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images\\/.*\\/(?:apko|melange[^/]*)\\.ya?ml$/"],
      "matchStrings": ["(?:^|\\n)[ \\t]*-[ \\t]+libstd\\+\\+=(?<currentValue>[^\\s]+)"],
      "datasourceTemplate": "repology",
      "depNameTemplate": "alpine_3_24/libstd++",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images\\/node\\/alpine\\/melange\\.npm(?:11|12)\\.yaml$/"],
      "matchStrings": ["\\n  version: (?<currentValue>\\d+\\.\\d+\\.\\d+)\\n"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "npm",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images\\/.*\\/melange[^/]*\\.ya?ml$/"],
      "matchStrings": [
        "https://codeload\\.github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/tar\\.gz/refs/tags/(?<currentValue>v\\d+\\.\\d+\\.\\d+)",
        "https://github\\.com/(?<depName>hadolint/hadolint)/releases/download/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    }
  ],
  "prBodyTemplate": "{{{table}}}{{{notes}}}{{{warnings}}}{{{controls}}}",
  "dependencyDashboard": true,
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["npm"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "rangeStrategy": "bump",
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchDepTypes": ["engines"],
      "enabled": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchPackageNames": ["typescript", "govuk-frontend"],
      "rangeStrategy": "bump",
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node", "hmpps-node"],
      "matchUpdateTypes": ["major"],
      "enabled": true,
      "pinDigests": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["workflow"],
      "matchFileNames": ["**/.github/workflows/**/*.ya?ml"],
      "enabled": true,
      "pinDigests": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/ministryofjustice/hmpps-node"],
      "replacementName": "ghcr.io/ministryofjustice/hmpps-hardened-container-images/node-alpine",
      "replacementVersion": "24-npm11-docker-main",
      "pinDigests": true
    },
    {
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest", "bump"],
      "groupName": "routine dependencies",
      "groupSlug": "routine-dependencies",
      "pinDigests": true,
      "minimumReleaseAge": "7 days",
      "automerge": true,
      "automergeComment": "Automatically merging routine dependency updates"
    },
    {
      "matchUpdateTypes": ["major"],
      "pinDigests": true,
      "groupName": null
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["images/**/apko.y*ml", "images/**/melange*.y*ml"],
      "automerge": false,
      "groupName": "apko and melange dependencies"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["images/node/alpine/melange.npm11.yaml"],
      "matchPackageNames": ["npm"],
      "allowedVersions": ">=11.0.0 <12.0.0"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["images/node/alpine/melange.npm12.yaml"],
      "matchPackageNames": ["npm"],
      "allowedVersions": ">=12.0.0 <13.0.0"
    }

  ],
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "7 days",
    "enabled": true,
    "labels": ["security-fix"]
  },
  "osvVulnerabilityAlerts": true,
  "platformCommit": "enabled"
}
