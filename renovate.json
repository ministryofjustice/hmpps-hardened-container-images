{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>ministryofjustice/hmpps-renovate-config:node",
    "helpers:pinGitHubActionDigests"
  ],
  "prBodyTemplate": "{{{table}}}{{{notes}}}{{{warnings}}}{{{controls}}}",
  "dependencyDashboard": true,
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "rangeStrategy": "bump",
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchDepTypes": ["engines"],
      "enabled": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchPackageNames": ["typescript", "govuk-frontend"],
      "rangeStrategy": "bump",
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node", "hmpps-node"],
      "matchUpdateTypes": ["major"],
      "enabled": true,
      "pinDigests": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["workflow"],
      "matchFileNames": ["**/.github/workflows/**/*.ya?ml"],
      "enabled": true,
      "pinDigests": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/ministryofjustice/hmpps-node"],
      "replacementName": "ghcr.io/ministryofjustice/hmpps-hardened-alpine-node-24",
      "replacementVersion": "v1.0.0",
      "pinDigests": true
    },
    {
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest", "bump"],
      "groupName": "routine dependencies",
      "groupSlug": "routine-dependencies",
      "pinDigests": true,
      "minimumReleaseAge": "7 days",
      "automerge": true,
      "automergeComment": "Automatically merging routine dependency updates"
    },
    {
      "matchUpdateTypes": ["major"],
      "pinDigests": true,
      "groupName": null
    }

  ],
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "7 days",
    "enabled": true,
    "labels": ["security-fix"]
  },
  "osvVulnerabilityAlerts": true,
  "platformCommit": "enabled"
}
